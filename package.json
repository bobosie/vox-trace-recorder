{
  "name": "vox-trace",
  "version": "0.1.0",
  "description": "Record manual browser sessions → structured data for AI-assisted test generation",
  "keywords": [
    "playwright",
    "recording",
    "test-generation",
    "e2e",
    "ai"
  ],
  "license": "MIT",
  "scripts": {
    "record": "tsx src/record-manual-session.ts",
    "keyframes": "bash src/extract-keyframes.sh",
    "spec": "tsx src/generate-spec.ts",
    "playwright": "tsx src/generate-playwright.ts",
    "index": "tsx src/generate-index.ts",
    "test": "tsx --test $(find src -name '*.test.ts')"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "js-yaml": "^4.1.1",
    "otpauth": "^9.5.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
