FROM node:20-slim

RUN apt-get update && apt-get install -y bash curl git

WORKDIR /app
COPY . /app/

# 安裝 npm 依賴
RUN npm install

# 安裝 Playwright Chromium（含系統依賴）
RUN npx playwright install --with-deps chromium

# 測試 auto-test 模式（headless，Docker 無 display 預期會失敗）
RUN npx tsx src/record-manual-session.ts --auto-test --no-audio --no-periodic-screenshots 2>/dev/null || echo "auto-test needs display, skip in Docker"

# 驗證核心模組
RUN node -e "require('playwright'); console.log('playwright OK')"
RUN test -f src/generate-spec.ts && echo "generate-spec OK"
RUN test -f src/transcribe.ts && echo "transcribe OK"

CMD ["sh", "-c", "echo '✅ All install tests passed'"]
